<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      There is deliberately no REQUEST_INSTALL_PACKAGES here any more. Up to 1.2.3 the app
      downloaded its own update APK and handed it to Android's installer, and that hand-off is the
      only thing the permission is for. To Play Protect, a sideloaded app that fetches code over
      the network and then asks to install it is a dropper - and a journal that also asks for the
      microphone is a worse-looking one - so it was flagged as harmful. The check is unchanged;
      what changed is who installs the file: the release opens in the browser and the phone's own
      installer takes the APK from outside the app.
    -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.UJournal">
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Not for updates any more: photos, video and recorded audio are written into the app's
             own files and handed to the camera, the player and the picker through this provider. -->
        <!-- This journal's birthdays, published in the same shape FamTM publishes its own, so the
             exchange runs both ways: FamTM can read what was typed here, and this app can read what
             FamTM keeps. Read-only and names-and-days only. -->
        <provider
            android:name=".Birthdays"
            android:authorities="app.ujournal.birthdays"
            android:exported="true" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
