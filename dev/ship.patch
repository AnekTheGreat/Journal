diff --git a/app/src/main/java/app/ujournal/Birthdays.kt b/app/src/main/java/app/ujournal/Birthdays.kt
new file mode 100644
index 0000000..db83809
--- /dev/null
+++ b/app/src/main/java/app/ujournal/Birthdays.kt
@@ -0,0 +1,73 @@
+package app.ujournal
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.database.MatrixCursor
+import android.net.Uri
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * UJournal's birthdays, published the same way FamTM publishes its own.
+ *
+ * FamTM hands its list over at `content://com.FamTM.app.birthdays/list`, which made the exchange one
+ * way: the journal could read the family's birthdays and FamTM could never see the ones typed here.
+ * This is the other half of the same contract - `content://app.ujournal.birthdays/list`, one row
+ * whose `json` column is `[{"n":name,"m":month,"d":day,"y":year}]` - so either app can be the one
+ * that knows a birthday.
+ *
+ * Read-only on purpose: a query answers, and insert, update and delete do nothing. Only a name and a
+ * day of the year are published, which is exactly what FamTM publishes and all a birthday reminder
+ * needs; nothing else in the journal is reachable through here.
+ */
+class Birthdays : ContentProvider() {
+
+    override fun onCreate(): Boolean = true
+
+    override fun query(
+        uri: Uri,
+        projection: Array<out String>?,
+        selection: String?,
+        selectionArgs: Array<out String>?,
+        sortOrder: String?
+    ): Cursor {
+        val cursor = MatrixCursor(arrayOf("json"))
+        cursor.addRow(arrayOf(list().toString()))
+        return cursor
+    }
+
+    /** Every birthday in this journal, in the shape FamTM already reads from its own provider. */
+    private fun list(): JSONArray {
+        val arr = JSONArray()
+        val ctx = context ?: return arr
+        runCatching {
+            Store(ctx).plans()
+                .filter { it.kind == "birthday" && it.title.isNotBlank() }
+                .forEach { p ->
+                    val md = p.start.takeLast(5)
+                    arr.put(
+                        JSONObject()
+                            .put("n", p.title)
+                            .put("m", md.take(2).toIntOrNull() ?: 0)
+                            .put("d", md.takeLast(2).toIntOrNull() ?: 0)
+                            .put("y", p.start.take(4).toIntOrNull() ?: 0)
+                    )
+                }
+        }
+        return arr
+    }
+
+    override fun getType(uri: Uri): String = "vnd.android.cursor.dir/vnd.ujournal.birthdays"
+
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = null
+
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int = 0
+
+    override fun update(
+        uri: Uri,
+        values: ContentValues?,
+        selection: String?,
+        selectionArgs: Array<out String>?
+    ): Int = 0
+}
diff --git a/app/src/main/java/app/ujournal/Bridge.kt b/app/src/main/java/app/ujournal/Bridge.kt
index f0e0ee3..dc330b5 100644
--- a/app/src/main/java/app/ujournal/Bridge.kt
+++ b/app/src/main/java/app/ujournal/Bridge.kt
@@ -168,0 +169,25 @@ class Bridge(private val ui: MainActivity) {
+    /**
+     * Both directions at once, which is what the one button in Plans runs: FamTM's birthdays come in,
+     * and this journal's go out through [Birthdays] at `content://app.ujournal.birthdays/list`, where
+     * FamTM reads them the same way this app reads its list. Returns what actually changed.
+     */
+    @JavascriptInterface
+    fun syncBirthdays(): String = runCatching {
+        val offered = FamTm.birthdays(ui) ?: emptyList()
+        val have = birthdays()
+        var added = 0
+        offered.filter { it.name.isNotBlank() && (it.name.lowercase() + "|" + it.md) !in have }
+            .forEach { b ->
+                store.savePlan(Plan("", b.name, b.date, "", b.date, "", "birthday", FROM_FAMTM))
+                added++
+            }
+        JSONObject()
+            .put("added", added)
+            .put("offered", offered.size)
+            .put("installed", FamTm.installed(ui))
+            // What this journal publishes back, counted after the import so the number is the truth
+            // of the list FamTM will read, not of the list before the tap.
+            .put("shared", store.plans().count { it.kind == "birthday" })
+            .toString()
+    }.getOrDefault("{}")
+
